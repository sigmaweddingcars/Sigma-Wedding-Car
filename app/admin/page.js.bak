"use client";
import { useState, useEffect } from "react";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import { Save, Plus, Trash2, Settings, Car, MessageSquare, Image, LogOut, ChevronRight, CheckCircle2, AlertCircle } from "lucide-react";
import { cn } from "@/lib/utils";

export default function AdminPage() {
    const [isLoggedIn, setIsLoggedIn] = useState(false);
    const [password, setPassword] = useState("");
    const [activeTab, setActiveTab] = useState("settings");
    const [loading, setLoading] = useState(true);
    const [saving, setSaving] = useState(false);
    const [msg, setMsg] = useState({ text: "", type: "success" });

    // Data states
    const [settings, setSettings] = useState(null);
    const [cars, setCars] = useState([]);
    const [reviews, setReviews] = useState([]);
    const [gallery, setGallery] = useState([]);

    useEffect(() => {
        // Ensure this only runs on the client
        if (typeof window !== 'undefined') {
            const auth = localStorage.getItem("adm_auth");
            if (auth === "true") {
                setIsLoggedIn(true);
                fetchData();
            } else {
                setLoading(false);
            }
        } else {
            setLoading(false);
        }
    }, []);

    const fetchData = async () => {
        try {
            console.log("Fetching admin data...");
            const res = await fetch('/api/data', { cache: 'no-store' });
            if (!res.ok) throw new Error(`HTTP error! status: ${res.status}`);
            const data = await res.json();

            setSettings(data.settings || {});
            setCars(Array.isArray(data.cars) ? data.cars : []);
            setReviews(Array.isArray(data.reviews) ? data.reviews : []);
            setGallery(Array.isArray(data.gallery) ? data.gallery : []);

            console.log("Data fetched successfully");
            setLoading(false);
        } catch (error) {
            console.error("Failed to fetch data:", error);
            // Even on error, we should stop loading to show at least something
            setLoading(false);
        }
    };

    const handleLogin = (e) => {
        e.preventDefault();
        // Matching the default in route.js
        if (password === "sigma_admin_2026") {
            setIsLoggedIn(true);
            localStorage.setItem("adm_auth", "true");
            fetchData();
        } else {
            alert("Incorrect password");
        }
    };

    const handleLogout = () => {
        setIsLoggedIn(false);
        localStorage.removeItem("adm_auth");
    };

    const saveChanges = async (type, dataToSave) => {
        setSaving(true);
        try {
            const res = await fetch('/api/data', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    type,
                    data: dataToSave,
                    token: "sigma_admin_2026"
                })
            });
            const result = await res.json();
            if (res.ok) {
                setMsg({ text: "Changes saved successfully", type: "success" });
            } else {
                setMsg({ text: result.error || "Failed to save", type: "error" });
            }
        } catch (error) {
            setMsg({ text: "Connection error", type: "error" });
        } finally {
            setSaving(false);
            setTimeout(() => setMsg({ text: "", type: "success" }), 3000);
        }
    };

    // Fleet Management Helpers
    const addCar = () => {
        const newCar = {
            id: `car-${Date.now()}`,
            name: "New Car",
            category: "Luxury",
            description: "",
            image: "/images/hero-car.png",
            seats: 5,
            decoration: true
        };
        setCars([...cars, newCar]);
    };

    const updateCar = (index, field, value) => {
        const updated = [...cars];
        updated[index] = { ...updated[index], [field]: value };
        setCars(updated);
    };

    const deleteCar = (index) => {
        if (confirm("Are you sure you want to delete this car?")) {
            setCars(cars.filter((_, i) => i !== index));
        }
    };

    if (loading) return <div className="h-screen flex items-center justify-center">Loading Dashboard...</div>;

    if (!isLoggedIn) {
        return (
            <div className="h-screen flex items-center justify-center bg-gray-50 p-4">
                <div className="max-w-md w-full bg-white p-8 rounded-2xl shadow-xl border border-gray-100">
                    <div className="text-center mb-8">
                        <div className="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                            <Settings className="h-8 w-8 text-primary" />
                        </div>
                        <h1 className="text-2xl font-serif font-bold">Admin Login</h1>
                        <p className="text-muted-foreground">Enter password to manage content</p>
                    </div>
                    <form onSubmit={handleLogin} className="space-y-4">
                        <div className="space-y-2">
                            <Label>Password</Label>
                            <Input
                                type="password"
                                value={password}
                                onChange={(e) => setPassword(e.target.value)}
                                placeholder="••••••••"
                                required
                            />
                        </div>
                        <Button type="submit" className="w-full h-12 text-lg">Access Dashboard</Button>
                    </form>
                </div>
            </div>
        );
    }

    return (
        <div className="min-h-screen bg-slate-50 flex flex-col md:flex-row">
            {/* Sidebar */}
            <aside className="w-full md:w-64 bg-white border-r border-slate-200 p-6 flex flex-col gap-8">
                <div className="flex items-center gap-2 text-xl font-serif font-bold">
                    <div className="w-8 h-8 bg-primary rounded-lg flex items-center justify-center text-white">Σ</div>
                    Sigma Admin
                </div>

                <nav className="flex flex-col gap-1">
                    <button
                        onClick={() => setActiveTab("settings")}
                        className={cn(
                            "flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-medium",
                            activeTab === "settings" ? "bg-primary/10 text-primary" : "text-slate-500 hover:bg-slate-50"
                        )}
                    >
                        <Settings className="h-5 w-5" /> General Settings
                    </button>
                    <button
                        onClick={() => setActiveTab("fleet")}
                        className={cn(
                            "flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-medium",
                            activeTab === "fleet" ? "bg-primary/10 text-primary" : "text-slate-500 hover:bg-slate-50"
                        )}
                    >
                        <Car className="h-5 w-5" /> Vehicle Fleet
                    </button>
                    <button
                        onClick={() => setActiveTab("reviews")}
                        className={cn(
                            "flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-medium",
                            activeTab === "reviews" ? "bg-primary/10 text-primary" : "text-slate-500 hover:bg-slate-50"
                        )}
                    >
                        <MessageSquare className="h-5 w-5" /> Testimonials
                    </button>
                    <button
                        onClick={() => setActiveTab("gallery")}
                        className={cn(
                            "flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-medium",
                            activeTab === "gallery" ? "bg-primary/10 text-primary" : "text-slate-500 hover:bg-slate-50"
                        )}
                    >
                        <Image className="h-5 w-5" /> Gallery links
                    </button>
                    <div className="mt-8 border-t pt-4">
                        <button onClick={handleLogout} className="flex items-center gap-3 px-4 py-3 text-red-500 hover:bg-red-50 rounded-xl w-full transition-all">
                            <LogOut className="h-5 w-5" /> Logout
                        </button>
                    </div>
                </nav>
            </aside>

            {/* Main Content */}
            <main className="flex-1 p-6 md:p-10 max-w-5xl">
                <div className="flex justify-between items-center mb-10">
                    <div>
                        <h2 className="text-3xl font-serif font-bold text-slate-900 capitalize">{activeTab.replace("-", " ")}</h2>
                        <p className="text-slate-500">Manage your website content in real-time</p>
                    </div>
                    {msg.text && (
                        <div className={cn(
                            "flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium animate-in fade-in slide-in-from-top-2",
                            msg.type === "success" ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700"
                        )}>
                            {msg.type === "success" ? <CheckCircle2 className="h-4 w-4" /> : <AlertCircle className="h-4 w-4" />}
                            {msg.text}
                        </div>
                    )}
                </div>

                {/* Section: General Settings */}
                {activeTab === "settings" && settings && (
                    <div className="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8 space-y-6">
                        <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div className="space-y-2">
                                <Label>Phone Number</Label>
                                <Input value={settings.phone} onChange={(e) => setSettings({ ...settings, phone: e.target.value })} />
                            </div>
                            <div className="space-y-2">
                                <Label>WhatsApp Number</Label>
                                <Input value={settings.whatsappNumber} onChange={(e) => setSettings({ ...settings, whatsappNumber: e.target.value })} />
                            </div>
                            <div className="space-y-2">
                                <Label>Instagram URL</Label>
                                <Input value={settings.instagramUrl} onChange={(e) => setSettings({ ...settings, instagramUrl: e.target.value })} />
                            </div>
                            <div className="space-y-2">
                                <Label>Email</Label>
                                <Input value={settings.email} onChange={(e) => setSettings({ ...settings, email: e.target.value })} />
                            </div>
                        </div>
                        <div className="space-y-2">
                            <Label>Address</Label>
                            <Input value={settings.address} onChange={(e) => setSettings({ ...settings, address: e.target.value })} />
                        </div>
                        <div className="space-y-2">
                            <Label>Footer Description</Label>
                            <Textarea rows={3} value={settings.footerDescription} onChange={(e) => setSettings({ ...settings, footerDescription: e.target.value })} />
                        </div>
                        <Button className="h-12 px-8" onClick={() => saveChanges("settings", settings)} disabled={saving}>
                            {saving ? "Saving..." : <span className="flex items-center gap-2"><Save className="h-4 w-4" /> Save Settings</span>}
                        </Button>
                    </div>
                )}

                {/* Section: Vehicle Fleet */}
                {activeTab === "fleet" && (
                    <div className="space-y-6">
                        <div className="flex justify-end">
                            <Button variant="outline" onClick={addCar} className="border-primary text-primary hover:bg-primary/5">
                                <Plus className="h-4 w-4 mr-2" /> Add New Car
                            </Button>
                        </div>
                        <div className="grid grid-cols-1 gap-6">
                            {Array.isArray(cars) && cars.map((car, idx) => (
                                <div key={car.id} className="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 flex flex-col md:flex-row gap-6">
                                    <div className="w-full md:w-48 aspect-video bg-slate-100 rounded-xl overflow-hidden relative">
                                        <img src={car.image} alt={car.name} className="object-cover w-full h-full" />
                                    </div>
                                    <div className="flex-1 space-y-4">
                                        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                                            <div className="space-y-1">
                                                <Label className="text-xs uppercase text-slate-400">Car Name</Label>
                                                <Input value={car.name} onChange={(e) => updateCar(idx, 'name', e.target.value)} />
                                            </div>
                                            <div className="space-y-1">
                                                <Label className="text-xs uppercase text-slate-400">Category</Label>
                                                <Input value={car.category} onChange={(e) => updateCar(idx, 'category', e.target.value)} />
                                            </div>
                                        </div>
                                        <div className="space-y-1">
                                            <Label className="text-xs uppercase text-slate-400">Description</Label>
                                            <Textarea value={car.description} rows={2} onChange={(e) => updateCar(idx, 'description', e.target.value)} />
                                        </div>
                                        <div className="flex justify-between items-center">
                                            <div className="flex gap-4">
                                                <div className="space-y-1">
                                                    <Label className="text-xs uppercase text-slate-400">Seats</Label>
                                                    <Input type="number" className="w-20" value={car.seats} onChange={(e) => updateCar(idx, 'seats', parseInt(e.target.value))} />
                                                </div>
                                                <div className="flex items-center gap-2 mt-6">
                                                    <input type="checkbox" id={`dec-${idx}`} checked={car.decoration} onChange={(e) => updateCar(idx, 'decoration', e.target.checked)} />
                                                    <Label htmlFor={`dec-${idx}`}>Includes Decoration</Label>
                                                </div>
                                            </div>
                                            <Button variant="destructive" size="icon" onClick={() => deleteCar(idx)} className="self-end">
                                                <Trash2 className="h-5 w-5" />
                                            </Button>
                                        </div>
                                    </div>
                                </div>
                            ))}
                        </div>
                        <Button className="h-12 w-full text-lg shadow-lg" onClick={() => saveChanges("cars", cars)} disabled={saving}>
                            {saving ? "Saving Fleet..." : "Save All Fleet Changes"}
                        </Button>
                    </div>
                )}

                {/* Sections for Reviews and Gallery could follow same pattern */}
                {activeTab === "reviews" && (
                    <div className="space-y-6">
                        <div className="bg-white rounded-2xl shadow-sm border border-slate-200 divide-y">
                            {Array.isArray(reviews) && reviews.map((rev, idx) => (
                                <div key={rev.id} className="p-6 flex justify-between items-start gap-4">
                                    <div className="flex-1 space-y-2">
                                        <div className="flex items-center gap-3">
                                            <span className="font-bold text-lg">{rev.name}</span>
                                            <span className="text-xs bg-primary/10 text-primary px-2 py-0.5 rounded-full">{rev.rating} Stars</span>
                                            <span className="text-slate-400 text-sm">{rev.date}</span>
                                        </div>
                                        <p className="text-slate-600 text-sm italic">"{rev.comment}"</p>
                                    </div>
                                    <Button variant="ghost" size="icon" onClick={() => {
                                        if (confirm("Remove this review?")) setReviews(reviews.filter((_, i) => i !== idx));
                                    }} className="text-red-400 hover:text-red-600 hover:bg-red-50">
                                        <Trash2 className="h-5 w-5" />
                                    </Button>
                                </div>
                            ))}
                        </div>
                        <Button className="h-12 w-full text-lg shadow-lg" onClick={() => saveChanges("reviews", reviews)} disabled={saving}>
                            Save Testimonial Changes
                        </Button>
                    </div>
                )}

                {activeTab === "gallery" && (
                    <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                        {Array.isArray(gallery) && gallery.map((item, idx) => (
                            <div key={item.id} className="bg-white p-4 rounded-2xl border border-slate-200 space-y-4">
                                <div className="aspect-square bg-slate-50 rounded-xl overflow-hidden">
                                    <img src={item.image} className="w-full h-full object-cover" />
                                </div>
                                <div className="space-y-2">
                                    <Label>Image Path</Label>
                                    <Input value={item.image} onChange={(e) => {
                                        const upd = [...gallery];
                                        upd[idx].image = e.target.value;
                                        setGallery(upd);
                                    }} />
                                    <Label>Instagram Link</Label>
                                    <Input value={item.link} onChange={(e) => {
                                        const upd = [...gallery];
                                        upd[idx].link = e.target.value;
                                        setGallery(upd);
                                    }} />
                                </div>
                            </div>
                        ))}
                        <Button className="h-12 md:col-span-2 w-full text-lg shadow-lg" onClick={() => saveChanges("gallery", gallery)} disabled={saving}>
                            Update Gallery Links
                        </Button>
                    </div>
                )}
            </main>
        </div>
    );
}
